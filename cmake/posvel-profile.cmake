option(MOTOR_POSVEL_URDF_PROFILE "Explicit seven-axis URDF POS_VEL deployment profile" OFF)
if(MOTOR_POSVEL_URDF_PROFILE)
    if(MOTOR_BENCH_JOINT7_POSVEL)
        message(FATAL_ERROR "Seven-axis profile conflicts with joint7 bench")
    endif()
    get_filename_component(profile_build_name "${CMAKE_BINARY_DIR}" NAME)
    if(profile_build_name STREQUAL "Debug" OR profile_build_name STREQUAL "Release")
        message(FATAL_ERROR "Seven-axis profile requires a separate build directory")
    endif()
    add_compile_definitions(MOTOR_POSVEL_URDF_PROFILE=1)
    message(WARNING "Seven-axis POS_VEL configured, not bench-qualified; verify gripper calibration before motion")
endif()
